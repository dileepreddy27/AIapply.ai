# Backend env (Render / local API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Storage bucket for resumes (create it in the Supabase dashboard)
SUPABASE_RESUME_BUCKET=resumes
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Map Stripe price ids to volume tiers (Starter/Pro/Power). Unmapped -> pro.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_POWER=
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app
# Optional regex for dynamic preview domains (Vercel, etc.)
CORS_ORIGIN_REGEX=^https://[a-zA-Z0-9-]+\.vercel\.app$
GOOGLE_FORM_ROLES_CSV_URL=
LIVE_GREENHOUSE_BOARDS=vercel,stripe,datadog,airbnb,databricks,hubspotjobs,Coinbase,scaleai,fivetran,robinhood,brex,airtable,discord,webflow,dropbox,checkr,asana,cloudflare,yugabyte,samsara,headway,growtherapy,transcarent
LIVE_LEVER_SITES=palantir,Flex,rhombus-systems,integrate,ifm-us,disqo,finix,hive,artera,revealtech,Ketch,getsquire,acceldata,sugarcrm,upguard,propelsoftware,bolster,onit,entrata,Versana,binance,afero,Way,versapay,Nexos,analyticpartners,weInfuse,qualysoft,syw.com,RyzLabs,cti-md,dnb,questanalytics,drivetrain,radformation,filevine,getcircuit,SwiftlySystems,anavationllc,applydigital,arcadia,biointellisense,xsolla,oci,shyftlabs,weride,celaralabs,viget,agiloft,lodgify,metabase,brightspot,coderpad,uvcyber,unlimit,orum,plaid,sysdig,immuta,easypost-2,oleria-security,valence,unstructuredtechnologies,neon,sonarsource,sophos
# Ashby job boards (jobs.ashbyhq.com/<org>) for live discovery
LIVE_ASHBY_BOARDS=ramp,openai,notion,linear,runway,mercury,clipboardhealth,vanta
# SmartRecruiters company identifiers (jobs.smartrecruiters.com/<company>)
LIVE_SMARTRECRUITERS_COMPANIES=
# Recruitee company subdomains (<company>.recruitee.com)
LIVE_RECRUITEE_COMPANIES=
# --- Aggregator APIs: pull LinkedIn/Indeed/Glassdoor/etc. in one call ---
# RapidAPI JSearch (rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=
RAPIDAPI_JSEARCH_HOST=jsearch.p.rapidapi.com
# SerpApi Google Jobs (serpapi.com) — indexes most of the web's job pages
SERPAPI_KEY=
# Optional location applied to aggregator queries (e.g. "United States")
JOB_LOCATION=
# Comma-separated RSS/Atom job feed URLs for niche boards
LIVE_RSS_FEEDS=
RESEND_API_KEY=
EMAIL_FROM=AIapply.ai <onboarding@resend.dev>
AUTO_APPLY_CRON_SECRET=
# Optional: absolute path to a resume file the experimental submit engine uploads
AUTO_APPLY_RESUME_PATH=
ENABLE_PREMIUM_TEST_MODE=true
# Anthropic assistant
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
